{
  "name": "weighingms",
  "version": "0.1.0",
  "private": true,
  "description": "WeighingMS — assisted dyestuff weighing station (FCI)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:ui": "vite --config vite.config.ts",
    "build:ui": "vite build --config vite.config.ts",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "evidence:step08": "node scripts/step08-ui-analysis.cjs",
    "verify:requirements": "node scripts/verify-requirements.cjs",
    "verify:skills": "node scripts/validate-skills.cjs",
    "verify:adrs": "node scripts/verify-adrs.cjs",
    "verify:fr-refs": "node scripts/verify-fr-refs.cjs",
    "verify:inception": "node scripts/verify-inception.cjs",
    "verify:frontmatter": "node scripts/verify-frontmatter.cjs",
    "verify:implementation": "node scripts/verify-implementation.cjs",
    "normalise:line-endings": "node scripts/normalise-line-endings.cjs",
    "normalise:timestamps": "node scripts/unquote-timestamps.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "fs-extra": "^11.4.1",
    "js-yaml": "^5.5.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
